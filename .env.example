NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/os_retirada"
# Fuso usado para converter timestamps em datas de negócio (dias úteis)
TZ_NEGOCIO=America/Bahia

# Autenticação
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
SESSAO_HORAS=8
# "true" apenas se a aplicação for servida por HTTPS
COOKIE_SECURE=false