NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/os_retirada"
# Fuso usado para converter timestamps em datas de negócio (dias úteis)
TZ_NEGOCIO=America/Bahia

# Autenticação
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
SESSAO_HORAS=8
# "true" apenas se a aplicação for servida por HTTPS
COOKIE_SECURE=false

# Rotina de prazos (Atrasada e timeout da reativação), em minutos. 0 desliga.
ROTINA_PRAZOS_MINUTOS=60

# Integração com o IXC — SOMENTE LEITURA (o IXC é apenas origem de dados; nada é enviado a ele)
IXC_URL=https://central.exemplo.com.br/webservice/v1
IXC_TOKEN=
# su_oss_chamado.id_assunto das OS de retirada
IXC_ID_ASSUNTO_RETIRADA=9
# Intervalo mínimo entre duas sincronizações (botão "Sincronizar agora")
SINCRONIZACAO_INTERVALO_MIN_MINUTOS=5
